{
  "components": {
    "schemas": {
      "Appeal": {
        "additionalProperties": false,
        "description": "A stored appeal with its state and the model version it refers to.",
        "properties": {
          "appeal_id": {
            "title": "Appeal Id",
            "type": "integer"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "status": {
            "enum": [
              "none",
              "open",
              "under_review",
              "resolved"
            ],
            "title": "Status",
            "type": "string"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "appeal_id",
          "worker_id",
          "reason",
          "requested_at",
          "status",
          "model_version"
        ],
        "title": "Appeal",
        "type": "object"
      },
      "AppealInfo": {
        "additionalProperties": false,
        "description": "State of a cashier's latest appeal, and how to ask for a review.",
        "properties": {
          "how_to_request": {
            "default": "POST /appeals with the worker id and a reason to ask for a review",
            "description": "Every score can be contested; a manager reviews the request.",
            "title": "How To Request",
            "type": "string"
          },
          "last_appeal_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Appeal Id"
          },
          "status": {
            "default": "none",
            "enum": [
              "none",
              "open",
              "under_review",
              "resolved"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "title": "AppealInfo",
        "type": "object"
      },
      "AppealRequest": {
        "additionalProperties": false,
        "description": "A cashier's request to review their score.",
        "properties": {
          "reason": {
            "maxLength": 2000,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "reason"
        ],
        "title": "AppealRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Service status, model version, number of cashiers and time of the latest run.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "n_workers": {
            "title": "N Workers",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model_version",
          "n_workers",
          "as_of"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Interval": {
        "additionalProperties": false,
        "description": "A confidence interval around a score.",
        "properties": {
          "lower": {
            "title": "Lower",
            "type": "number"
          },
          "upper": {
            "title": "Upper",
            "type": "number"
          }
        },
        "required": [
          "lower",
          "upper"
        ],
        "title": "Interval",
        "type": "object"
      },
      "RankedScoreResponse": {
        "additionalProperties": false,
        "description": "One line of a ranking in a context.",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "context": {
            "enum": [
              "peak",
              "off"
            ],
            "title": "Context",
            "type": "string"
          },
          "effective_score": {
            "description": "Score used for ordering; unrated workers are placed at the cohort average.",
            "title": "Effective Score",
            "type": "number"
          },
          "interval": {
            "$ref": "#/components/schemas/Interval"
          },
          "provisional": {
            "title": "Provisional",
            "type": "boolean"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "review_flag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Flag"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C",
              "unrated"
            ],
            "title": "Tier",
            "type": "string"
          },
          "unrated": {
            "title": "Unrated",
            "type": "boolean"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "rank",
          "context",
          "score",
          "effective_score",
          "tier",
          "unrated",
          "interval",
          "confidence",
          "provisional",
          "review_flag"
        ],
        "title": "RankedScoreResponse",
        "type": "object"
      },
      "RankingResponse": {
        "additionalProperties": false,
        "description": "A ranking of cashiers with the settings that produced it.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "context": {
            "enum": [
              "peak",
              "off"
            ],
            "title": "Context",
            "type": "string"
          },
          "min_confidence": {
            "title": "Min Confidence",
            "type": "number"
          },
          "ranking": {
            "items": {
              "$ref": "#/components/schemas/RankedScoreResponse"
            },
            "title": "Ranking",
            "type": "array"
          }
        },
        "required": [
          "context",
          "as_of",
          "min_confidence",
          "ranking"
        ],
        "title": "RankingResponse",
        "type": "object"
      },
      "ScoreComponents": {
        "additionalProperties": false,
        "description": "The parts of a score: speed and accuracy scores, sample sizes and confidence.",
        "properties": {
          "accuracy_score": {
            "title": "Accuracy Score",
            "type": "number"
          },
          "confidence_off": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Off",
            "type": "number"
          },
          "confidence_peak": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Peak",
            "type": "number"
          },
          "error_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Rate"
          },
          "n_valid_off": {
            "title": "N Valid Off",
            "type": "integer"
          },
          "n_valid_peak": {
            "title": "N Valid Peak",
            "type": "integer"
          },
          "speed_method": {
            "title": "Speed Method",
            "type": "string"
          },
          "speed_score_off": {
            "title": "Speed Score Off",
            "type": "number"
          },
          "speed_score_peak": {
            "title": "Speed Score Peak",
            "type": "number"
          },
          "void_rate_per_100": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Void Rate Per 100"
          }
        },
        "required": [
          "speed_score_peak",
          "speed_score_off",
          "accuracy_score",
          "n_valid_peak",
          "n_valid_off",
          "error_rate",
          "void_rate_per_100",
          "confidence_peak",
          "confidence_off",
          "speed_method"
        ],
        "title": "ScoreComponents",
        "type": "object"
      },
      "ScoreResponse": {
        "additionalProperties": false,
        "description": "A score record together with the state of the cashier's appeal.",
        "properties": {
          "appeal": {
            "$ref": "#/components/schemas/AppealInfo"
          },
          "components": {
            "$ref": "#/components/schemas/ScoreComponents"
          },
          "computed_at": {
            "format": "date-time",
            "title": "Computed At",
            "type": "string"
          },
          "drivers": {
            "items": {
              "type": "string"
            },
            "title": "Drivers",
            "type": "array"
          },
          "interval_off": {
            "$ref": "#/components/schemas/Interval"
          },
          "interval_peak": {
            "$ref": "#/components/schemas/Interval"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "n_transactions": {
            "minimum": 0.0,
            "title": "N Transactions",
            "type": "integer"
          },
          "provisional": {
            "title": "Provisional",
            "type": "boolean"
          },
          "review_flag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Flag"
          },
          "score_off": {
            "title": "Score Off",
            "type": "number"
          },
          "score_peak": {
            "title": "Score Peak",
            "type": "number"
          },
          "tier_off": {
            "enum": [
              "A",
              "B",
              "C",
              "unrated"
            ],
            "title": "Tier Off",
            "type": "string"
          },
          "tier_peak": {
            "enum": [
              "A",
              "B",
              "C",
              "unrated"
            ],
            "title": "Tier Peak",
            "type": "string"
          },
          "weeks_of_data": {
            "minimum": 0.0,
            "title": "Weeks Of Data",
            "type": "integer"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "score_peak",
          "score_off",
          "interval_peak",
          "interval_off",
          "tier_peak",
          "tier_off",
          "n_transactions",
          "weeks_of_data",
          "provisional",
          "review_flag",
          "drivers",
          "model_version",
          "computed_at",
          "components",
          "appeal"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only scores for the shift planner (Part 2) and the review screen. Scores are decision support: a manager validates every plan, and any worker can contest their own score through POST /appeals.",
    "title": "Cashier efficiency scores",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/appeals": {
      "get": {
        "description": "Stored review requests, for one cashier or for all.",
        "operationId": "list_appeals_appeals_get",
        "parameters": [
          {
            "in": "query",
            "name": "worker_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Worker Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Appeal"
                  },
                  "title": "Response List Appeals Appeals Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Appeals",
        "tags": [
          "appeals"
        ]
      },
      "post": {
        "description": "Record a cashier's request to have a score reviewed.",
        "operationId": "create_appeal_appeals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppealRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appeal"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Appeal",
        "tags": [
          "appeals"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report that the service is up, with the model version and the number of cashiers.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "service"
        ]
      }
    },
    "/scores": {
      "get": {
        "description": "All current score records, each with the state of the cashier's appeal.",
        "operationId": "list_scores_scores_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScoreResponse"
                  },
                  "title": "Response List Scores Scores Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Scores",
        "tags": [
          "scores"
        ]
      }
    },
    "/scores/ranking": {
      "get": {
        "description": "Cashiers ranked by their peak or off-peak score.\n\nUnrated cashiers are placed at the average of the rated ones and flagged.",
        "operationId": "ranking_scores_ranking_get",
        "parameters": [
          {
            "description": "peak or off-peak score",
            "in": "query",
            "name": "context",
            "required": true,
            "schema": {
              "description": "peak or off-peak score",
              "enum": [
                "peak",
                "off"
              ],
              "title": "Context",
              "type": "string"
            }
          },
          {
            "description": "Workers whose confidence is below this value are treated as unrated: they stay in the list, placed at the cohort average and flagged.",
            "in": "query",
            "name": "min_confidence",
            "required": false,
            "schema": {
              "default": 0.0,
              "description": "Workers whose confidence is below this value are treated as unrated: they stay in the list, placed at the cohort average and flagged.",
              "maximum": 1.0,
              "minimum": 0.0,
              "title": "Min Confidence",
              "type": "number"
            }
          },
          {
            "description": "use the latest run up to this time",
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "use the latest run up to this time",
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ranking",
        "tags": [
          "scores"
        ]
      }
    },
    "/scores/{worker_id}": {
      "get": {
        "description": "Score record of one cashier, or 404 when there is none.",
        "operationId": "get_score_scores__worker_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "worker_id",
            "required": true,
            "schema": {
              "title": "Worker Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Score",
        "tags": [
          "scores"
        ]
      }
    }
  }
}